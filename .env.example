# GitHub personal access token (server-only).
# Used to load the contribution calendar on the homepage.
# Create at: https://github.com/settings/tokens
# Classic token: no scopes required for public contribution data (or use fine-grained with read access to public profile).
# Never commit the real token. Put it in `.env.local` for local dev, and in Vercel env vars for production.
GITHUB_TOKEN=

# Optional: public site URL for metadata / sitemap
# NEXT_PUBLIC_SITE_URL=https://rahul-bot.vercel.app
